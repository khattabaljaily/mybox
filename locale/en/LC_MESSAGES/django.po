msgstr "The trash is empty."

msgid "سيُحذف المستند وملفاته نهائيًا ولا يمكن التراجع عن ذلك."
msgstr "The document and its files will be permanently deleted. This cannot be undone."

msgid "ستُحذف كل المستندات في السلة نهائيًا ولا يمكن التراجع عن ذلك."
msgstr "Every document in the trash will be permanently deleted. This cannot be undone."

msgid "إفراغ"
msgstr "Empty"

msgid "عرض كل الإشعارات"
msgstr "View all notifications"

msgid "لا توجد إشعارات"
msgstr "No notifications"

#, python-format
msgid "مستند \"%(title)s\" في MyBox يحتاج إلى مراجعة. يُرجى رفع المستند الجديد في أقرب وقت."
msgstr "Your document \"%(title)s\" in MyBox needs your attention. Please upload the new document as soon as possible."

#, python-format
msgid "مستند \"%(title)s\" في MyBox انتهت صلاحيته بتاريخ %(expiry)s. يُرجى رفع المستند الجديد في أقرب وقت."
msgstr "Your document \"%(title)s\" in MyBox expired on %(expiry)s. Please upload the new document as soon as possible."

#, python-format
msgid "مستند \"%(title)s\" في MyBox سينتهي خلال %(days_before)s يوم (بتاريخ %(expiry)s). يُرجى رفع المستند الجديد في أقرب وقت."
msgstr "Your document \"%(title)s\" on MyBox will expire in %(days_before)s days (on %(expiry)s). Please upload the new document as soon as possible."

msgid "لا توجد إشعارات."
msgstr "No notifications."
